+// Some OpenAI-compatible gateways reject the model bank's advertised output
+// limit (for example 128000) even when a chapter needs far fewer tokens.
+// Apply this only for the serial novel process, which sets the env var.
+function capSerialMaxTokens(requested) {
+    const raw = process.env.INKOS_SERIAL_MAX_TOKENS;
+    if (!raw)
+        return requested;
+    const cap = Number(raw);
+    if (!Number.isInteger(cap) || cap < 2048 || cap > 16384)
+        throw new Error("INKOS_SERIAL_MAX_TOKENS must be an integer from 2048 to 16384");
+    return Math.min(requested, cap);
+}
