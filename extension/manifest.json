{
  "manifest_version": 3,
  "name": "Reader 小说平台导入助手",
  "version": "0.3.20",
  "description": "从 Reader 选择小说，填入番茄或七猫作者后台。",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://xw9114.github.io/reader/*",
    "https://zuozhe.qimao.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Reader 小说平台导入助手",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fanqienovel.com/main/writer*",
        "https://writer.muyewx.com/*",
        "https://zuozhe.qimao.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
